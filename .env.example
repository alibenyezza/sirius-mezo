# ─────────────────────────────────────────────────────────────
# Sirius — template d'environnement
# Copier en .env.local et remplir : cp .env.example .env.local
# Ne jamais commiter de vraie valeur ici.
# ─────────────────────────────────────────────────────────────

# Base de données (Prisma + PostgreSQL)
# Postgres. Le SQLite d'origine ne convient ni au serverless, qui n'a pas de disque
# persistant, ni à un reaper qui tourne dans un autre processus que l'application.
DATABASE_URL="postgresql://user:motdepasse@hote:5432/sirius?schema=public"
# Pool par instance. Chaque instance serverless froide ouvre le sien : une valeur
# généreuse épuise les connexions de la base avant d'être utile.
DATABASE_POOL_MAX="5"

# ─────────────────────────────────────────────────────────────
# EVM — Mezo, la chaîne Bitcoin EVM-compatible. Rail cible.
# testnet 31611 (0x7b7b) · mainnet 31612 (0x7b7c) · gas en BTC natif · règlement en MUSD
#
# Le projet cible le TESTNET. Rien n'y coûte d'argent réel, les contrats sont
# redéployables librement. BTC de test : https://faucet.test.mezo.org
# MUSD de test : emprunter contre du BTC sur https://testnet.mezo.org
# Le mainnet est une décision distincte : le script de déploiement le refuse
# sans SIRIUS_ALLOW_MAINNET=true.
# ─────────────────────────────────────────────────────────────
EVM_NETWORK="testnet"                    # testnet | mainnet
EVM_RPC_URL=""                           # vide = RPC public de la chaîne (https://rpc.test.mezo.org)
NEXT_PUBLIC_EVM_NETWORK="testnet"        # doit correspondre à EVM_NETWORK, sinon signatures rejetées

# Finalité rapide (src/lib/evm/fast-finality.ts, docs/ESCROW-V6.md).
# Absent ou false : comportement historique partout (bloc finalized sur mainnet, ~15 min deux fois).
# true : les prêts (dataset + calcul) ≤ MAX, tant que la somme des prêts rapides en cours ≤ TOTAL,
# sont acceptés après CONFIRMATIONS blocs L2 (1 à 100) et contrôle du hash canonique. Ces confirmations
# couvrent une vue RPC en retard, pas une défaillance du séquenceur : risque accepté, borné. Mêmes
# valeurs sur Next et le reaper ; le runner tient les siennes (dont son propre TOTAL) du Compose
# attesté (deploy/phala/compose.v7.yaml).
SIRIUS_FAST_FINALITY="false"
SIRIUS_FAST_FINALITY_MAX_USDC="25"       # seuil par prêt, en unités du jeton
SIRIUS_FAST_FINALITY_TOTAL_USDC="100"    # plafond des prêts rapides en cours (Next seulement)
SIRIUS_FAST_FINALITY_CONFIRMATIONS="30"

# Adresses des contrats Sirius, renseignées après déploiement.
NEXT_PUBLIC_SIRIUS_ESCROW_ADDRESS=""
NEXT_PUBLIC_SIRIUS_KYB_ADDRESS=""
NEXT_PUBLIC_SIRIUS_DATASET_ADDRESS=""
NEXT_PUBLIC_SIRIUS_USDC_ADDRESS=""

# Configuration privée du runner EVM (ne jamais exposer dans le navigateur).
SIRIUS_ESCROW_ADDRESS=""
SIRIUS_USDC_ADDRESS=""
SIRIUS_USDC_CODE_HASH=""               # keccak256 du bytecode MUSD, requis au déploiement
                                       # MUSD testnet 0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
                                       # → 0xc0d0630dacd16463b0390f3914920cb4cbbe3586e7a51ef0d71930249756f474
SIRIUS_KYB_ADDRESS=""
SIRIUS_DATASET_ADDRESS=""
SIRIUS_LEGACY_ESCROW_ADDRESSES=""      # anciens escrows approuvés, même réseau, séparés par des virgules
SIRIUS_MIGRATION_ESCROW_ADDRESSES=""   # préflight uniquement : tous les escrows utilisés par cette base

# Déploiement des contrats (jamais chargé par l'application, uniquement par Hardhat).
MEZO_DEPLOYER_KEY=""
MEZO_TESTNET_RPC=""
MEZO_MAINNET_RPC=""
SIRIUS_KYB_ADMIN=""                    # adresse de gouvernance distincte
SIRIUS_KYB_VERIFIER=""                 # adresse du service KYB externe/HSM
SIRIUS_LOCK_AUTHORIZER=""              # adresse publique attendue du runner : déploiement v6, activation CVM et smoke
SIRIUS_SMOKE_PROVIDER_ADDRESS=""       # provider déjà attesté, utilisé par contracts:smoke
SIRIUS_SMOKE_DATASET_ID=""              # identifiant d'un titre EVM live de ce provider, utilisé par contracts:smoke
SIRIUS_SMOKE_MODEL_ID="linear_regression" # linear_regression | logistic_regression

# Connexion sociale (portefeuille embarqué MPC) — dashboard.web3auth.io
# Le Client ID est public : il identifie l’application auprès des nœuds, il n’autorise rien.
# La dérivation dépend du couple (Client ID, compte Google) : en changer donne une nouvelle
# adresse à tous les utilisateurs, sans erreur visible. Un projet par environnement.
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=""        # vide = pas de bouton « Continuer avec Google »
NEXT_PUBLIC_WEB3AUTH_NETWORK="sapphire_devnet"  # sapphire_devnet | sapphire_mainnet

# On-ramp fiat (MoonPay sandbox) — inc.3b
NEXT_PUBLIC_MOONPAY_PUBLISHABLE_KEY=""  # pk_test_...
MOONPAY_SECRET_KEY=""                    # sk_test_... (signature d'URL, serveur)

# Le signer KYB est externe à l'application : HSM, KMS ou prestataire KYB.
# Ne jamais injecter sa clé privée dans Next.js ni dans le runner.

# ─── Accès instantané KYB (docs/passage-mainnet/14-kyb.md) ───────────────────
# Un second vérificateur, automatique, signe depuis Next une invitation de 30 jours pour le
# wallet connecté ; le wallet l'accepte lui-même on-chain (une transaction, gas à sa charge).
# La clé ne signe que des messages : aucune transaction, aucun ETH. Elle doit être DÉDIÉE
# (jamais SIRIUS_KYB_VERIFIER_KEY, jamais le vérificateur humain) et ajoutée au registre par
# le Safe admin : addVerifier(<adresse dérivée>). Générer : openssl rand -hex 32 (préfixer 0x).
# Valeur exacte « true » pour activer ; absente ou autre valeur = route 404, aucune invitation.
# « true » sans clé valide refuse de démarrer. Interrupteurs : drapeau à false puis redéploiement
# (plus aucune émission) ; removeVerifier par le Safe (toutes les attestations émises invalidées).
# Plafonds : 1 invitation par wallet et par 24 h, N par adresse IP et par heure (seulement si
# SIRIUS_TRUST_PROXY_HEADERS=true), et au plus N par heure sur l'instance. Les traces (wallet,
# code, IP) sont supprimées par le reaper après 48 h. Pour révoquer une attestation précise
# (POST /api/admin/kyb/revoke, équipe seulement), l'adresse doit détenir ~0,001 ETH.
# SIRIUS_KYB_AUTO_INVITE="true"
# SIRIUS_KYB_AUTO_INVITE_KEY=""                 # 0x + 64 hex, marquer « Sensitive » sur Vercel
# SIRIUS_KYB_AUTO_INVITE_MAX_PER_HOUR="120"     # entier 1–1000, défaut 120
# SIRIUS_KYB_AUTO_INVITE_MAX_PER_IP_HOUR="3"    # entier 1–1000, défaut 3
# Attestation parrainée à la connexion (exige l'accès instantané ci-dessus) : le wallet signe
# seulement son consentement, le vérificateur automatique pose l'attestation et paie le gas.
# L'adresse du vérificateur doit alors détenir du BTC (parrainage suspendu sous 0,0002 ETH).
# SIRIUS_KYB_AUTO_SPONSOR="true"

# IPFS / Pinata
PINATA_JWT=""
PINATA_GATEWAY="https://gateway.pinata.cloud"

# Chiffrement datasets (AES-256-GCM) — clé maître 32 bytes en base64
# Générer : openssl rand -base64 32
SIRIUS_MASTER_KEY=""

# Auth API — indépendant de la master key TEE
# Générer : openssl rand -base64 32
SIRIUS_SESSION_SECRET=""

# Équipe Sirius — adresses EVM des administrateurs, séparées par des virgules, toute casse
# acceptée (comparées en minuscules). Réserve le self training à l'équipe côté serveur :
# GET et POST /api/train, POST /api/train/[id]/key répondent 403 « Bientôt disponible » aux
# autres wallets, sauf sur une instance de démonstration Phala (SIRIUS_PHALA_DEMO=true sur
# testnet, enclave Phala) où la liste des jobs et un POST porté par un grant de démo restent
# ouverts aux visiteurs : voir docs/passage-mainnet/10-self-training.md.
# GET /api/admin/me dit à l'interface si le wallet connecté est admin.
# Vide ou absente = personne n'est admin. Une seule entrée invalide (ou l'adresse nulle, une
# virgule finale, plus de dix entrées doublons compris) refuse toute la liste.
# Variable distincte de SIRIUS_DEMO_OPERATORS, réservée aux opérateurs de la démo Phala
# (route /api/phala-demo/operator côté Next et contrôleur).
# Le script de reprise `pnpm ops:verify-model-delivery` passe par ces routes : l'adresse
# dérivée de MEZO_DEPLOYER_KEY doit figurer ici sur l'instance qu'il interroge.
SIRIUS_ADMIN_ADDRESSES=""

# TEE — Phala dstack (stub swappable en dev)
TEE_MODE="stub"            # stub | phala
SIRIUS_REQUIRE_PHALA="false" # pipeline : true sur main, même sur testnet ; false sur staging/dev
# En mode phala : URL du simulateur dstack en dev ; en CVM, laissé vide → socket du guest-agent
# (/var/run/dstack.sock). La master key est alors dérivée dans l'enclave (getKey), pas via env.
# ⚠ phala + simulateur est REFUSÉ en production (clé non scellée matériellement).
DSTACK_SIMULATOR_ENDPOINT=""
# Mesures épinglées après validation du déploiement CVM. Elles vivent dans l’environnement
# de l’application Next qui vérifie le runner, jamais dans le compose de la CVM (sinon le
# compose_hash changerait au moment même de son épinglage).
SIRIUS_EXPECTED_MRTD=""
SIRIUS_EXPECTED_COMPOSE_HASH=""
# Facultatif et informatif : RTMR3 change à chaque redémarrage de la CVM, il n'est plus lu par
# le code (audit A-01). L'identité du code est prouvée par MRTD, le compose hash et le journal
# d'événements rejoué vers le RTMR3 de la quote.
SIRIUS_EXPECTED_RTMR3=""
# Empreinte SHA-256 canonique de la signature_chain renvoyée avec sirius/master/v1.
SIRIUS_EXPECTED_MASTER_KEY_CHAIN_SHA256=""
# SHA-256 de la clé P-256 brute d'ingestion, affiché au boot du runner puis épinglé au build Next.
NEXT_PUBLIC_SIRIUS_INGRESS_KEY_SHA256=""

# Runner confidentiel isolé (inc.3d-B, D-25) : service qui détient la master key enclave.
# En production : URL HTTPS en passthrough vers la CVM ; le certificat et sa clé sont générés
# par dstack dans la CVM puis authentifiés par quote TDX avant tout envoi métier.
# Vide = fallback in-process DEV uniquement.
RUNNER_URL=""
RUNNER_PORT="4100"
RUNNER_BOOTSTRAP_ONLY="false" # CVM uniquement : expose l’identité RA-TLS, refuse toutes les opérations métier
RUNNER_TLS_HOSTNAME=""       # hostname exact de RUNNER_URL, obligatoire dans la CVM de production
RUNNER_TLS_ALT_NAMES=""      # SAN supplémentaires séparés par des virgules, optionnel
RUNNER_TLS_ENABLED="false"   # production = toujours actif ; utile avec un simulateur en développement
RUNNER_TRANSPORT_SECRET=""  # authentification du canal Next↔runner, aucun droit métier
RUNNER_REPLAY_DIR=""         # volume persistant runner ; obligatoire en production
RUNNER_MAX_BODY_MB="24"      # plafond transport runner ; upload applicatif limité à 3 MiB
RUNNER_MAX_CONNECTIONS="32"
RUNNER_MAX_CONCURRENT_REQUESTS="8"
RUNNER_MAX_CONCURRENT_UPLOADS="1"
RUNNER_MAX_CONCURRENT_JOBS="1"
RUNNER_TRAINING_TIMEOUT_MS="15000"
SIRIUS_APP_ORIGIN="http://localhost:3000" # origine autorisée dans les délégations wallet
SIRIUS_APP_ORIGIN_ALIASES="" # origines supplémentaires explicites, séparées par des virgules
NEXT_PUBLIC_SIRIUS_APP_ORIGIN="" # canonique au build ; vide en local = origine du navigateur
SIRIUS_MAX_CONCURRENT_UPLOADS="2" # plafond app avant lecture des enveloppes chiffrées
# Reaper en cours de processus : pratique en développement, sans effet en serverless
# où aucun processus ne survit entre deux requêtes. En production, le reaper tourne
# comme worker autonome — voir `pnpm reaper:start` et src/worker/reaper.ts.
SIRIUS_REAPER_ENABLED="true" # réconciliation autonome des prêts et escrows bloqués
SIRIUS_REAPER_INTERVAL_MS="30000"
# Worker VPS : retrait automatique des crédits d'escrow par `withdrawFor`, gas payé par Sirius.
# Désactivé par défaut ; seuil et plafond n'ont aucune valeur implicite. Une clé par worker,
# distincte du faucet, du vérificateur KYB, du runner et de la trésorerie ; ETH seulement.
SIRIUS_WITHDRAW_RELAYER_ENABLED="false"
SIRIUS_WITHDRAW_RELAYER_KEY=""            # 0x + 64 hex
SIRIUS_WITHDRAW_RELAYER_MIN_USDC=""       # ex. « 1 » : aucun retrait automatique en dessous
SIRIUS_WITHDRAW_RELAYER_DAILY_GAS_ETH=""  # plafond de gas par jour UTC, ex. « 0.01 »
SIRIUS_TRUST_PROXY_HEADERS="false" # true seulement si l’ingress écrase X-Real-IP
SIRIUS_INGRESS_RATE_LIMITED="false" # production : limites distribuées IP/globales imposées par l’ingress

# ─── Mode démonstration ───────────────────────────────────────────────────────
# Construit comme la production, configuré pour un réseau de test, sans enclave
# réelle. Sans lui, une instance servie publiquement exige un TEE attesté et le
# mainnet — ce qui rend toute démonstration impossible avant ce jalon.
# Valeur exacte « demo » : un « 1 » ou un « true » laissé par mégarde n activerait rien.
# Interdit sur mainnet, où l instance repasse par la porte stricte.
SIRIUS_DEPLOYMENT_MODE=""
NEXT_PUBLIC_SIRIUS_DEPLOYMENT_MODE="" # doit valoir « demo » aussi : le bandeau en dépend

# Les deux comptes que la maison finance en mode démonstration, et qui doivent rester
# distincts : le faucet est la seule dépense qu’un visiteur déclenche librement, tandis que
# l’attestation KYB conditionne l’emprunt comme la publication. Partager une clé exposerait
# à ce qu’un faucet vidé retire le KYB à tout le monde. Les deux sont exigées au démarrage.
SIRIUS_FAUCET_KEY=""          # 0x + 64 hex, compte dédié, approvisionné en ETH
SIRIUS_KYB_VERIFIER_KEY=""    # 0x + 64 hex, signe les attestations parrainées

# ─── Porte d'aperçu du passage mainnet ───────────────────────────────────────
# Pendant la mise en production, le public voit une page d'attente (/coming-soon) et toutes
# les routes API répondent 503, sauf une liste blanche minimale (src/lib/preview-gate/gate.ts :
# /api/auth/challenge pour le test de fumée, /terms, /preview, fichiers statiques). L'équipe
# ouvre une fois https://sirius-data.tech/preview?key=<SIRIUS_PREVIEW_KEY> : un cookie
# `sirius_preview` (HMAC dérivé de la clé, 7 jours, propre à chaque domaine : à refaire sur
# chaque alias) lui rend le site complet. /terms reste lisible sans portefeuille.
# Valeur exacte « true » pour activer ; absente ou autre valeur = comportement habituel.
# Fermée par défaut : « true » sans clé valide ferme le site à tous, équipe comprise.
# Ne se pose que sur le projet Vercel de production, jamais sur staging ni en local.
# SIRIUS_PREVIEW_GATE="true"
# Clé d'ouverture, 32 caractères minimum, URL-safe. Générer : openssl rand -hex 32
# Marquer « Sensitive » sur Vercel ; la retirer avec l'interrupteur au lancement, et en
# régénérer une neuve à chaque remise en place : elle transite dans des URL.
# SIRIUS_PREVIEW_KEY=""

# ─── Assistant Sirio (chat Claude dans la bulle du guide) ─────────────────────
# Valeur exacte « true » pour activer la route POST /api/assistant/chat ; absente ou autre
# valeur = route 404, la bulle n'affiche que les réponses fixes et le contact, et rien n'est
# exigé au démarrage. « true » sans clé ou sans secret refuse de démarrer.
# La clé Anthropic est lue par le SDK côté serveur seulement ; le secret signe les réponses
# renvoyées au navigateur (l'historique non signé est écarté). Marquer les deux « Sensitive »
# sur Vercel ; jamais sur le reaper ni le runner. Générer le secret : openssl rand -hex 32.
# Garde-fous : origine contrôlée, 10 questions par minute par IP (SIRIUS_TRUST_PROXY_HEADERS)
# ou wallet signé, 1000 caractères par message, 10 messages et 6000 caractères d'historique,
# 800 jetons de réponse au plus ; en base (tables AssistantUsage, AssistantClientUsage) : N
# questions par jour et par client, plafond de requêtes et budget estimé par jour UTC.
# Journal : compteurs (jetons, coût estimé, latence) seulement, jamais le contenu.
# SIRIUS_ASSISTANT_ENABLED="true"
# ANTHROPIC_API_KEY=""                     # sk-ant-…, jamais NEXT_PUBLIC_
# SIRIUS_ASSISTANT_SECRET=""               # 32 caractères au moins, dédié
# SIRIUS_ASSISTANT_DAILY_CAP="500"         # entier 1–2000, défaut 500 requêtes par jour UTC
# SIRIUS_ASSISTANT_DAILY_BUDGET_USD="5"    # décimal 0,01–1000, défaut 5 $ estimés par jour UTC
# SIRIUS_ASSISTANT_DAILY_PER_IP="40"       # entier 1–1000, défaut 40 questions par client et par jour

# Serveur MCP public en lecture seule (POST /api/mcp, voir docs/MCP.md) : catalogue, fiche, profils,
# état du protocole et vérification de certificat, sans session ni achat. Absent ou autre valeur
# que « true » : la route répond 404. Aucun secret requis.
# SIRIUS_MCP_ENABLED="true"

# Tarif de calcul affiché par la page d'upload (Next seulement). Même contenu JSON que le
# fichier RUNNER_BILLING_POLICY_FILE du runner ; information publique, pas un secret.
# SIRIUS_BILLING_POLICY_JSON='{"version":1,...}'
