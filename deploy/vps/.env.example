# Environnement du VPS. À copier en .env.vps sur la machine, jamais dans le dépôt.
#
# Ce fichier ne contient que ce dont le reaper a besoin. Il n'a aucune raison de
# recevoir les secrets de l'enclave, les clés de règlement ou les jetons Pinata :
# le reaper ne déchiffre rien et ne signe rien.

# Image publiée par le pipeline, épinglée par digest. Le tag est volontairement
# absent : il est mutable, le digest ne l'est pas.
SIRIUS_WORKER_IMAGE="ghcr.io/alibenyezza/sirius-worker@sha256:..."

# Base Postgres. La même que celle de l'application — le reaper réconcilie les
# prêts que l'application a créés.
DATABASE_URL="postgresql://user:motdepasse@hote/sirius?sslmode=require"
DATABASE_POOL_MAX="5"

# Cadence de réconciliation. Entre 5 000 et 300 000 ms.
SIRIUS_REAPER_INTERVAL_MS="30000"

# Chaîne. Doit désigner exactement le même déploiement que l'application :
# le reaper lit des états d'escrow, un contrat différent donnerait des états faux.
EVM_NETWORK="testnet"
EVM_RPC_URL=""
SIRIUS_ESCROW_ADDRESS="0x62713b79afa7bae393514ee79a653aab889af7dc"
SIRIUS_DATASET_ADDRESS="0x..."
SIRIUS_LEGACY_ESCROW_ADDRESSES=""
SIRIUS_USDC_ADDRESS=""
SIRIUS_KYB_ADDRESS=""

# Aligner avec Next et le runner lors de la bascule v7.
SIRIUS_BILLING_VERSION="6"
SIRIUS_EVM_FINALITY="finalized"
SIRIUS_EVM_CONFIRMATIONS="1"
SIRIUS_REQUIRE_PHALA="false"
TEE_MODE="stub"
RUNNER_URL=""
RUNNER_TRANSPORT_SECRET=""
SIRIUS_LOCK_AUTHORIZER=""
SIRIUS_EXPECTED_MRTD=""
SIRIUS_EXPECTED_COMPOSE_HASH=""
# Facultatif, informatif : RTMR3 change à chaque redémarrage de la CVM et n'est plus épinglé (audit A-02).
SIRIUS_EXPECTED_RTMR3=""
SIRIUS_EXPECTED_MASTER_KEY_CHAIN_SHA256=""
NEXT_PUBLIC_SIRIUS_INGRESS_KEY_SHA256=""
