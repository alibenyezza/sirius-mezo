FROM node:22-bookworm-slim AS dependencies

ENV NEXT_TELEMETRY_DISABLED=1
ENV DATABASE_URL=file:./prisma/dev.db
ENV PNPM_CONFIG_FETCH_RETRIES=5
ENV PNPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000
ENV PNPM_CONFIG_FETCH_TIMEOUT=300000
ENV PNPM_CONFIG_NETWORK_CONCURRENCY=8
WORKDIR /workspace
RUN corepack enable
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml prisma.config.ts tsconfig.json ./
COPY patches ./patches
COPY prisma ./prisma
RUN mkdir -p src
RUN --mount=type=cache,id=sirius-corepack,target=/root/.cache/node/corepack,sharing=locked \
    --mount=type=cache,id=sirius-pnpm-store,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile

FROM node:22-bookworm-slim AS app

ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /workspace
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

COPY --from=dependencies --chown=node:node /workspace/node_modules ./node_modules
COPY --from=dependencies --chown=node:node /workspace/package.json /workspace/prisma.config.ts /workspace/tsconfig.json ./
COPY --from=dependencies --chown=node:node /workspace/prisma ./prisma
COPY --chown=node:node src ./src
COPY --from=dependencies --chown=node:node /workspace/src/generated/prisma ./src/generated/prisma
COPY --chown=node:node next-env.d.ts next.config.ts postcss.config.mjs ./
COPY --chown=node:node public ./public
RUN mkdir -p .next /workspace/data && chown node:node .next /workspace/data

USER node
CMD ["node", "node_modules/next/dist/bin/next", "dev", "-H", "0.0.0.0"]

FROM node:22-bookworm-slim AS runner

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS="--conditions=react-server --max-old-space-size=384"
WORKDIR /workspace

COPY --from=dependencies --chown=node:node /workspace/node_modules ./node_modules
COPY --from=dependencies --chown=node:node /workspace/package.json /workspace/tsconfig.json ./
COPY --chown=node:node src ./src
COPY --from=dependencies --chown=node:node /workspace/src/generated/prisma ./src/generated/prisma
RUN mkdir -p /var/lib/sirius-runner/replay && chown -R node:node /var/lib/sirius-runner

USER node
CMD ["node", "--import", "tsx", "src/runner/dev.ts"]
